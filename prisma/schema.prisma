generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Book {
  id        Int      @id @default(autoincrement())
  title     String   @unique @db.VarChar(160)
  author    String   @db.VarChar(120)
  genre     String   @db.VarChar(60) // área o género
  imageUrl  String   @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reviews   Review[]
}

// La calificación del libro NO se guarda: se calcula con AVG(rating) al consultar.
model Review {
  id        Int      @id @default(autoincrement())
  bookId    Int
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId    String   @db.VarChar(64) // sub de Cognito
  userName  String   @db.VarChar(60)
  rating    Int // CHECK 1–10 en la migración
  opinion   String   @db.Text // máx. 1000, validado con zod + CHECK
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookId, userId])
  @@index([bookId])
}
